{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/decision-system-governance/control-plane/control-ticket.schema.json",
  "title": "Governance Control Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "ticket"
  ],
  "properties": {
    "schema_version": {
      "const": "governance-control-ticket-v3"
    },
    "route": {
      "enum": [
        "intelligence",
        "compute",
        "expert"
      ]
    },
    "ticket": {
      "type": "object",
      "description": "Exact child-center ticket without task_id; governance injects a deterministic task_id."
    },
    "wait_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 2700,
      "default": 2400
    }
  }
}
