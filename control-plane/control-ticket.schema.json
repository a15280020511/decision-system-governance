{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/decision-system-governance/control-plane/control-ticket.schema.json",
  "title": "Governance Control Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "ticket"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "governance-control-ticket-v3",
        "governance-control-ticket-v4"
      ]
    },
    "client_request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Client-generated idempotency key required for v4 and created before POST."
    },
    "route": {
      "enum": [
        "intelligence",
        "compute",
        "expert"
      ]
    },
    "ticket": {
      "type": "object",
      "description": "Exact child-center ticket without task_id; governance injects a deterministic task_id."
    },
    "wait_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 2700,
      "default": 2400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "governance-control-ticket-v4"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "client_request_id"
        ]
      }
    }
  ]
}
