{
  "schema_version": "gpts-control-ticket-templates-v1",
  "control_schema_version": "governance-control-ticket-v4",
  "allowed_routes": [
    "intelligence",
    "compute",
    "expert"
  ],
  "forbidden_schema_aliases": [
    "4",
    "v4",
    "governance-v4"
  ],
  "forbidden_route_aliases": [
    "research",
    "analysis",
    "strategy",
    "api",
    "simulation",
    "strategic_intelligence_analysis"
  ],
  "route_mapping": {
    "current public-data retrieval, source collection and evidence acquisition": "intelligence",
    "deterministic statistics, optimization, simulation and numerical analysis": "compute",
    "strategy, policy, business, multidisciplinary judgment and synthesis": "expert"
  },
  "common_rules": {
    "title": "[control]",
    "client_request_id": "canonical UUID generated before POST",
    "task_id": "must be omitted because governance generates it",
    "secrets": "forbidden",
    "post_attempts_per_logical_task": 1,
    "automatic_post_retry": false
  },
  "bounded_ingress_compatibility": {
    "purpose": "recover structurally unambiguous client representations without widening the public three-route contract",
    "frontend_aliases_remain_forbidden": true,
    "canonical_public_routes_remain": [
      "intelligence",
      "compute",
      "expert"
    ],
    "resolution_order": [
      "accept an exact canonical route",
      "otherwise infer exactly one canonical route from ticket structure",
      "reject malformed, conflicting or ambiguous structures"
    ],
    "schema_repairs": {
      "4": "governance-control-ticket-v4",
      "4.0": "governance-control-ticket-v4",
      "v4": "governance-control-ticket-v4",
      "governance-v4": "governance-control-ticket-v4"
    },
    "structural_route_repairs": {
      "ticket containing operation": "compute",
      "ticket containing objective, data_policy, requests and acceptance": "intelligence",
      "canonical expert ticket": "expert",
      "narrative title/user_request/requirements ticket": "expert",
      "strategic task/constraints/evidence_requirements/output_structure/scope ticket": "expert"
    },
    "route_name_policy": {
      "noncanonical_names_are_not_individually_whitelisted": true,
      "route_label_is_secondary_to_unique_ticket_structure": true,
      "invalid_or_overlong_route_labels_fail_closed": true
    },
    "unknown_fields_fail_closed": true,
    "generic_query_without_explicit_connector_plan_fails_closed": true,
    "normalization_is_audited": true,
    "normalization_status_fields": [
      "request_schema_version_original",
      "request_schema_version",
      "compatibility_normalized",
      "compatibility_normalizations"
    ]
  },
  "templates": {
    "intelligence": {
      "schema_version": "governance-control-ticket-v4",
      "client_request_id": "00000000-0000-4000-8000-000000000000",
      "route": "intelligence",
      "ticket": {
        "query": "Describe the public-data or evidence request",
        "requirements": [
          "State source, date and evidence quality requirements"
        ],
        "language": "zh-CN"
      },
      "wait_seconds": 2400
    },
    "compute": {
      "schema_version": "governance-control-ticket-v4",
      "client_request_id": "00000000-0000-4000-8000-000000000000",
      "route": "compute",
      "ticket": {
        "operation": "descriptive_statistics",
        "inputs": {
          "data": [
            1,
            2,
            3
          ]
        }
      },
      "wait_seconds": 2400
    },
    "expert": {
      "schema_version": "governance-control-ticket-v4",
      "client_request_id": "00000000-0000-4000-8000-000000000000",
      "route": "expert",
      "ticket": {
        "objective": "Describe the decision or assessment objective",
        "pipeline": "expert-team",
        "task": {
          "question": "State the complete question to be answered",
          "requirements": [
            "State evidence, uncertainty, comparison and output requirements"
          ],
          "language": "zh-CN"
        },
        "execution_acceptance": [
          "A complete final synthesis is published",
          "Facts, inference and unknowns are separated"
        ],
        "evidence": [],
        "approved_budget": {
          "calls": 8,
          "maximum_recovery_calls": 1
        },
        "private_output": false
      },
      "wait_seconds": 2700
    }
  },
  "expert_field_mapping": {
    "title": "ticket.objective",
    "user_request": "ticket.task.question",
    "requirements": "ticket.task.requirements",
    "output_language": "ticket.task.language",
    "strategic.task": "ticket.task.question",
    "strategic.constraints": "ticket.task.requirements",
    "strategic.evidence_requirements": "ticket.task.requirements",
    "strategic.output_structure": "ticket.task.requirements",
    "strategic.scope": "ticket.task.requirements"
  },
  "expert_forbidden_top_level_ticket_fields": [
    "title",
    "user_request",
    "output_language",
    "task_id",
    "governance_model_plan"
  ]
}
